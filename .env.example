# Django Settings
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,dev.api.saaradhigo.in

# Database Settings
# For SQLite, leave DATABASE_URL empty
# For PostgreSQL, use: postgres://user:password@host:port/dbname
DATABASE_URL=

# Redis/Channels Settings
# For InMemoryChannelLayer, leave REDIS_URL empty
# For RedisChannelLayer, use: redis://host:port/db
REDIS_URL=
